# Required for the app database. Already set on Vercel production, preview, and development.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Required before sign-in, dashboard, or mobile bearer auth can succeed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required before owner or public chat can call the model.
OPENAI_API_KEY=

# Required for rate limits that are shared across server instances.
# Without these, limits are still enforced inside each instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
